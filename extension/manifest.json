{
  "manifest_version": 3,
  "name": "XYZ Player Stream Launcher",
  "version": "1.1",
  "description": "Sayfadaki anime ve video akışlarını tek tıkla D: diskindeki mpv (Vulkan + Anime4K) oynatıcısına aktarır.",
  "permissions": ["activeTab", "scripting", "webRequest", "storage"],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Videoyu XYZ mpv Player'da Aç",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
